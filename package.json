{
  "name": "funnel-metrics-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Funnel conversion rate and stage dwell time statistics API with an in-memory data layer and a React demo.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "start": "node server.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/metrics.test.js",
    "test:e2e": "playwright test --config=playwright.config.js",
    "perf": "node --test --test-name-pattern=performance tests/metrics.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22"
  }
}
